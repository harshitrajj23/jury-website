# NEON DATABASE CONFIGURATION
# Paste your Neon PostgreSQL connection string here (from Neon Console: Dashboard -> Connection Details)
DATABASE_URL="postgresql://neondb_owner:your_password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Direct connection (optional, same as DATABASE_URL for Neon serverless)
DIRECT_URL="postgresql://neondb_owner:your_password@ep-your-endpoint.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# UPSTASH REDIS (OPTIONAL - for distributed multi-instance Serverless Pub/Sub)
# If not provided, the built-in fast SSE bus + fallback polling operates seamlessly
UPSTASH_REDIS_REST_URL="https://your-upstash-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"
